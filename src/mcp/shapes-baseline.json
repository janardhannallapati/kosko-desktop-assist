        "tags": {
          "types": [
            "array"
          ]
        },
        "tasks": {
          "types": [
            "array"
          ]
        },
        "title": {
          "types": [
            "string"
          ]
        },
        "updateSequenceNumber": {
          "types": [
            "number"
          ]
        },
        "updated": {
          "types": [
            "string"
          ]
        },
        "version": {
          "types": [
            "number"
          ]
        }
      }
