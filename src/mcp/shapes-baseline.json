        "id": {
          "types": [
            "string"
          ]
        },
        "notebookId": {
          "types": [
            "string"
          ]
        },
        "resources": {
          "types": [
            "array"
          ],
          "items": {
            "types": [
              "object"
            ],
            "keys": {
              "hash": {
                "types": [
                  "string"
                ]
              },
              "id": {
                "types": [
                  "string"
                ]
              },
              "mime": {
                "types": [
                  "string"
                ]
