            "boolean"
          ]
        },
        "startIndex": {
          "types": [
            "number"
          ]
        },
        "totalResultCount": {
          "types": [
            "number"
          ]
        }
      }
    }
  },
  "envelopes": {
    "get_attachment": [
      "structuredContent+text"
    ],
    "get_note": [
      "structuredContent+text"
    ],
    "search_notes": [
      "structuredContent+text"
    ]
  }
