{
  "format": "kosko-shapes-baseline",
  "version": 1,
  "server": {
    "types": [
      "object"
    ],
    "keys": {
      "capabilities": {
        "types": [
          "object"
        ],
        "keys": {
          "tools": {
            "types": [
              "object"
            ],
            "keys": {}
          }
        }
      },
      "protocolVersion": {
        "types": [
          "string"
        ]
      },
      "serverInfo": {
        "types": [
          "object"
        ],
        "keys": {
          "name": {
            "types": [
              "string"
            ]
          },
          "version": {
            "types": [
              "string"
            ]
          }
        }
      }
    }
  },
  "tools": {
    "search_notes": {
      "properties": [
        "ascending",
        "clientTimeZone",
        "fullBooleanSearch",
        "maxResults",
        "query",
        "sortBy",
        "startIndex"
      ],
      "required": [
        "query"
      ]
    },
    "get_note": {
