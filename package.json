{
  "name": "kosko-desktop-assist",
  "version": "0.0.1",
  "private": true,
  "description": "Moves a whole Evernote account into Kosko from the user's own computer. Reads Evernote's local data read-only; the database file never leaves the machine.",
  "type": "module",
  "bin": {
    "kosko-assist": "bin/kosko-assist.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.mjs",
    "test:core": "npm --prefix packages/enex-core test",
    "test:all": "npm test && npm run test:core"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@kosko-app/enex-core": "0.3.0"
  },
  "devDependencies": {
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-highlight": "3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-subscript": "3.30.5",
    "@tiptap/extension-superscript": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-text-align": "3.30.5",
    "@tiptap/extension-text-style": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/starter-kit": "3.30.5"
  }
}
